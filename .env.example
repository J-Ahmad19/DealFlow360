# ──────────────────────────────────────────────
# Environment variables for DealFlow360 server
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Security
JWT_SECRET=supersecret12345678901234567890123456789012

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealflow_db

# Upstash Redis (leave blank to skip Redis in dev)
REDIS_URL=
REDIS_TOKEN=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
